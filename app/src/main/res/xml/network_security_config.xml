<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prohíbe el tráfico HTTP en texto claro y exige HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>